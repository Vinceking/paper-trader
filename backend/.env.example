# Copy to .env and fill in. NEVER commit .env.

ENVIRONMENT=development

# ---- Alpaca: PAPER ONLY ----------------------------------------------------
# Free paper account needs only an email address: https://alpaca.markets
# Never put live-account keys in this project.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex          # free tier. 'sip' requires Algo Trader Plus ($99/mo)

# Safety rail — the app refuses to boot if this is anything but false.
ENABLE_LIVE_TRADING=false

# ---- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/paper_trader
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-before-deploying

# ---- Market data -----------------------------------------------------------
MAX_STREAM_SYMBOLS=30         # free tier websocket cap
BAR_FINALIZE_GRACE_SECONDS=2.0
STREAM_HEARTBEAT_TIMEOUT_SECONDS=60

# ---- LLM (explanation layer) ----------------------------------------------
LLM_PROVIDER=grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
EXPLANATION_MODEL=grok-4.6    # tier 2: minimal reasoning, optimize latency
ANALYSIS_MODEL=grok-4.6       # tier 3: higher reasoning, runs overnight
